{
  "name": "aether-learn-backend-v2",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target node",
    "dev": "NODE_ENV=development bun --hot run src/index.ts",
    "start": "bun run dist/index.js",
    "db:migrate": "bunx prisma migrate dev --schema=./prisma/schema.prisma",
    "db:generate": "bunx prisma generate --schema=./prisma/schema.prisma",
    "db:studio": "bunx prisma studio --schema=./prisma/schema.prisma",
    "db:seed": "bun run src/scripts/seed.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.1",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "@types/jsonwebtoken": "^9.0.9",
    "bcrypt-ts": "^7.1.0",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "prisma": "^6.9.0",
    "swagger-jsdoc": "5.0.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.64"
  }
}
