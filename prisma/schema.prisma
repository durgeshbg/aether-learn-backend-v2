// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum CodeSolutionStatus {
  SUBMITTED
  GRADED
}

enum DifficultyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  firstName String?
  lastName  String?
  password  String
  branch    String?
  year      Int?
  uniqueId  String? @unique
  role      Role    @default(USER)

  organizationId String?
  organization   Organization? @relation("OrganizationUsers", fields: [organizationId], references: [id], onDelete: Cascade)

  orgAdminOf Organization? @relation("OrganizationAdmin")

  quizResults   QuizResult[]   @relation("UserResult")
  codeSolutions CodeSolution[] @relation("UserCodeSolutions")

  streakCount  Int       @default(0)
  lastActiveAt DateTime?

  bookmarkedModules      BookmarkModule[]
  enrolledCourseProgress EnrolledCourseProgress[]
  courseFeedbacks        CourseFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email], name: "idx_user_email")
  @@index([uniqueId], name: "idx_user_uniqueId")
}

model EnrolledCourseProgress {
  id             String @id @default(cuid())
  completionRate Float  @default(0.0)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  completedModules     Module[]
  completedQuizzes     Quiz[]
  completedAssessments CodeAssessment[]

  nextModuleId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model BookmarkModule {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  moduleId String
  module   Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, moduleId])
}

model Organization {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  logoUrl     String?
  websiteUrl  String?
  address     String?
  phone       String?
  email       String?

  orgAdminId String? @unique
  orgAdmin   User?   @relation("OrganizationAdmin", fields: [orgAdminId], references: [id])

  users   User[]   @relation("OrganizationUsers")
  courses Course[]

  usersCount   Int @default(0)
  coursesCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Course {
  id           String          @id @default(cuid())
  name         String
  description  String?
  thumbnailUrl String?
  rating       Float           @default(0.0)
  difficulty   DifficultyLevel @default(BEGINNER)

  lessons         Lesson[]         @relation("CourseLessons")
  quizzes         Quiz[]           @relation("CourseQuizzes")
  codeAssessments CodeAssessment[] @relation("CourseCodeAssessments")
  organizations   Organization[]

  lessonsCount         Int @default(0)
  modulesCount         Int @default(0)
  quizzesCount         Int @default(0)
  codeAssessmentsCount Int @default(0)

  enrolledCourseProgress EnrolledCourseProgress[]
  courseFeedback         CourseFeedback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseFeedback {
  id      String  @id @default(cuid())
  rating  Int     @default(0)
  comment String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
}

model Lesson {
  id      String @id @default(cuid())
  title   String
  content String

  difficulty DifficultyLevel @default(BEGINNER)
  objectives String[]

  courseId String
  course   Course @relation("CourseLessons", fields: [courseId], references: [id], onDelete: Cascade)

  modules Module[] @relation("LessonModules")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Module {
  id      String @id @default(cuid())
  title   String
  content String

  code       String?
  languageId Int

  difficulty      DifficultyLevel @default(BEGINNER)
  objectives      String[]
  durationMinutes Int             @default(0)

  lessonId String
  lesson   Lesson @relation("LessonModules", fields: [lessonId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookmarkedUsers          BookmarkModule[]
  EnrolledCourseProgress   EnrolledCourseProgress? @relation(fields: [enrolledCourseProgressId], references: [id])
  enrolledCourseProgressId String?
}

model Quiz {
  id          String  @id @default(cuid())
  title       String
  description String?

  difficulty      DifficultyLevel @default(BEGINNER)
  durationMinutes Int             @default(0)
  passPercentage  Int             @default(70)
  maxAttempts     Int             @default(3)

  courseId String
  course   Course @relation("CourseQuizzes", fields: [courseId], references: [id], onDelete: Cascade)

  questions   Question[]   @relation("QuizQuestions")
  quizResults QuizResult[] @relation("QuizResult")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  EnrolledCourseProgress   EnrolledCourseProgress? @relation(fields: [enrolledCourseProgressId], references: [id])
  enrolledCourseProgressId String?
}

model Question {
  id          String   @id @default(cuid())
  text        String
  options     String[]
  answer      Int
  explanation String?

  quizId String
  quiz   Quiz   @relation("QuizQuestions", fields: [quizId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuizResult {
  id    String @id @default(cuid())
  score Int    @default(0)

  userId String
  user   User   @relation("UserResult", fields: [userId], references: [id], onDelete: Cascade)

  quizId String
  quiz   Quiz   @relation("QuizResult", fields: [quizId], references: [id], onDelete: Cascade)

  responses String[]
  passed    Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CodeAssessment {
  id          String @id @default(cuid())
  title       String
  description String

  instructions String
  starterCode  String
  languageId   Int

  difficulty      DifficultyLevel @default(BEGINNER)
  durationMinutes Int             @default(0)

  courseId String
  course   Course @relation("CourseCodeAssessments", fields: [courseId], references: [id], onDelete: Cascade)

  codeSolutions CodeSolution[] @relation("CodeAssessmentSolutions")
  testCases     TestCase[]     @relation("CodeAssessmentTestCases")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  EnrolledCourseProgress   EnrolledCourseProgress? @relation(fields: [enrolledCourseProgressId], references: [id])
  enrolledCourseProgressId String?
}

model TestCase {
  id          String  @id @default(cuid())
  input       String
  expected    String
  description String?

  assessmentId String
  assessment   CodeAssessment @relation("CodeAssessmentTestCases", fields: [assessmentId], references: [id], onDelete: Cascade)

  weight Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CodeSolution {
  id     String             @id @default(cuid())
  code   String
  status CodeSolutionStatus @default(SUBMITTED)
  score  Int                @default(0)

  userId String
  user   User   @relation("UserCodeSolutions", fields: [userId], references: [id], onDelete: Cascade)

  assessmentId String
  assessment   CodeAssessment @relation("CodeAssessmentSolutions", fields: [assessmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
